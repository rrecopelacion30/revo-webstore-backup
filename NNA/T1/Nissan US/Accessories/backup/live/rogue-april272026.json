                      "value": "<div class=\"themeVehicleBannerWrap\">\n    <div class=\"themeVehicleBannerCard\">\n        <div class=\"themeVehicleBannerImg\">\n            <img src=\"https://rparts-sites.s3.amazonaws.com/223b3e40451187171b9a7229149b1553/design/accessories/acc_rogue.webp\" alt=\"Nissan Accessories Banner\">\n        </div>\n        <div class=\"themeVehicleBannerBoxCont\">\n            <div class=\"themeVehicleBannerContent\">\n                <h1>\n                    Redefine Versatility – Shop Genuine Nissan Rogue Accessories Online\n                </h1>\n                <p>\n                    Enhance your Nissan Rogue with accessories that suit your active lifestyle. Whether it’s all-weather floor mats for rugged adventures, cargo organizers for family trips, or roof rails for extra storage, we’ve got you covered. Shop now and enjoy fast shipping across the US. Make your Rogue as versatile as you are!\n                </p>\n                \n            </div>\n        </div>\n    </div>\n</div>"
