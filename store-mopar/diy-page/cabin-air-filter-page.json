                {
                  "moduleId": "module_126",
                  "moduleType": "custom_html",
                  "title": "Featured Install",
                  "options": {
                    "html_content": {
                      "name": "Custom HTML Content",
                      "type": "html_content",
                      "default_value": "",
                      "value": "<section class=\"content-block\">\n  <h2 class=\"content-block__title\">Before You Begin</h2>\n\n  <p>\n    Replacing your cabin air filter is a simple maintenance task that helps improve interior air quality and supports proper HVAC system performance.\n  </p>\n\n  <p>\n    Genuine Mopar<sub>®</sub> cabin air filters are engineered for Chrysler, Dodge, Jeep, and Ram vehicles and are designed to provide:\n  </p>\n\n  <ul class=\"icon-list\">\n    <li>Vehicle-specific fitment and easy installation</li>\n    <li>Improved filtration of dust, pollen, and airborne particles</li>\n    <li>Enhanced airflow through the heating and air conditioning system</li>\n    <li>Reliable performance and long-lasting durability</li>\n  </ul>\n\n  <div class=\"themeFeaturedInstallButton\">\n    <a href=\"https://store.mopar.com/cabin-air-filters\">Shop Mopar<sub>®</sub> Cabin Air Filters</a>\n  </div>\n</section>"
                    },
