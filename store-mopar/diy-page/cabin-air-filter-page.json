                {
                  "moduleId": "module_143",
                  "moduleType": "custom_html",
                  "title": "Tools You'll Need",
                  "options": {
                    "html_content": {
                      "name": "Custom HTML Content",
                      "type": "html_content",
                      "default_value": "",
                      "value": "<section class=\"tools-section\">\n  <p class=\"tools-section__intro\">\n    Most cabin air filter replacements can be completed with minimal tools and only take a few minutes.<br>\n    Before you begin, gather:\n  </p>\n\n  <div class=\"tools-grid\">\n\n    <div class=\"tool-item\">\n      <div class=\"tool-icon\">\n        <!-- cabin filter icon -->\n        <svg viewBox=\"0 0 120 70\" aria-hidden=\"true\">\n          <rect x=\"30\" y=\"18\" width=\"60\" height=\"34\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\"></rect>\n          <path d=\"M40 22 V48 M48 22 V48 M56 22 V48 M64 22 V48 M72 22 V48 M80 22 V48\" stroke=\"currentColor\" stroke-width=\"2\"></path>\n        </svg>\n      </div>\n      <p>New replacement<br>cabin air filter</p>\n    </div>\n\n    <div class=\"tool-item\">\n      <div class=\"tool-icon\">\n        <!-- screwdriver icon -->\n        <svg viewBox=\"0 0 120 70\" aria-hidden=\"true\">\n          <path d=\"M25 45 L75 20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"4\" stroke-linecap=\"round\"></path>\n          <path d=\"M75 20 L90 15 L95 25 L80 30 Z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\"></path>\n          <rect x=\"18\" y=\"40\" width=\"15\" height=\"10\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\"></rect>\n        </svg>\n      </div>\n      <p>Screwdriver<br>(if required)</p>\n    </div>\n\n    <div class=\"tool-item\">\n      <div class=\"tool-icon\">\n        <!-- microfiber cloth icon -->\n        <svg viewBox=\"0 0 120 70\" aria-hidden=\"true\">\n          <path d=\"M28 20 C45 12, 72 12, 92 22 L92 48 C70 39, 47 39, 28 48 Z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linejoin=\"round\"></path>\n          <path d=\"M28 20 L28 48\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\"></path>\n          <path d=\"M92 22 L92 48\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\"></path>\n        </svg>\n      </div>\n      <p>Clean cloth<br>or vacuum</p>\n    </div>\n\n  </div>\n</section>"
                    },
                    "force_lazy": {
