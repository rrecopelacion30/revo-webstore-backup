                      "default_value": "",
                      "value": "<div class=\"page-builder-layout-column-wrap full-height-wrapper \"> <div class=\"page-builder-layout-module    \"> <div class=\"custom-html-module\"> <div class=\"themeFeaturedInstallWrapper\"> <h3 class=\"themeFeaturedInstall\">TOOLS YOU'LL NEED</h3> </div> </div>  </div>   </div>"
                    },
