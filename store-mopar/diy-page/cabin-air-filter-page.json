                  "title": "Title: How to Replace Wiper Blades, Step-by-Step",
                  "options": {
                    "html_content": {
                      "name": "Custom HTML Content",
                      "type": "html_content",
                      "default_value": "",
                      "value": "<div class=\"page-builder-layout-column-wrap full-height-wrapper \"> <div class=\"page-builder-layout-module    \"> <div class=\"custom-html-module\"> <div class=\"themeFeaturedInstallWrapper\"> <h3 class=\"themeFeaturedInstall\">How to Replace Cabin Filter, Step-by-Step</h3> </div> </div>  </div>   </div>"
                    },
                    "force_lazy": {
